{
  "name": "@iris-ide/extensions",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript extension SDK and trusted-module host for a Tauri/Monaco IDE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./adapters/monaco": {
      "types": "./dist/adapters/monaco.d.ts",
      "import": "./dist/adapters/monaco.js"
    },
    "./adapters/acp": {
      "types": "./dist/adapters/acp.d.ts",
      "import": "./dist/adapters/acp.js"
    },
    "./adapters/xterm": {
      "types": "./dist/adapters/xterm.d.ts",
      "import": "./dist/adapters/xterm.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node examples/demo.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "monaco-editor": "0.56.0",
    "typescript": "~5.9.3",
    "xterm": "5.3.0"
  },
  "peerDependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "monaco-editor": "^0.56.0",
    "xterm": "^5.3.0"
  },
  "peerDependenciesMeta": {
    "@agentclientprotocol/sdk": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    },
    "xterm": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13"
  }
}
